# PostgreSQL connection string (ex: Neon serverless)
DATABASE_URL=

# Secret for signing session cookies (generate with: openssl rand -hex 32)
SESSION_SECRET=

# Replit app ID — used as OAuth client_id for Replit OIDC
REPL_ID=

# Public URL of this backend (used to build the OAuth callback URL)
# Ex: https://nexio-backend.onrender.com
BACKEND_URL=

# Public URL of the frontend (used to redirect after login/logout)
# Ex: https://nexio.vercel.app
FRONTEND_URL=
